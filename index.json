[{"authors":null,"categories":null,"content":"I am an assistant professor at the Web and Information Technologies lab at the Université Libre De Bruxelles (ULB). Prior to that I was an assistant professor at the Technical University of Vienna, and a Marie Skłodowska Curie fellow at the \u0026ldquo;Athena\u0026rdquo; Research Center and at the Hong Kong University of Science and Technology. I have a Diploma and a PhD in Computer Engineering from the National Technical University of Athens, and a MSc in Computer Science from the University of Southern California.\nIn my research, I am interested in topics related to data science and data engineering.\n Download my resumé. -- ","date":-62135596800,"expirydate":-62135596800,"kind":"term","lang":"en","lastmod":-62135596800,"objectID":"3495c87bfbc8ae4a71454561af45ba03","permalink":"","publishdate":"0001-01-01T00:00:00Z","relpermalink":"","section":"authors","summary":"I am an assistant professor at the Web and Information Technologies lab at the Université Libre De Bruxelles (ULB). Prior to that I was an assistant professor at the Technical University of Vienna, and a Marie Skłodowska Curie fellow at the \u0026ldquo;Athena\u0026rdquo; Research Center and at the Hong Kong University of Science and Technology.","tags":null,"title":"Dimitris Sacharidis","type":"authors"},{"authors":["Daniel Defiebre","Dimitris Sacharidis","Panagiotis Germanakos"],"categories":[],"content":"","date":1577836800,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1612133342,"objectID":"c68e77d1fbc414d7ac6a0f91531306df","permalink":"/publication/dblp-confum-defiebre-sg-20/","publishdate":"2021-01-31T23:19:13.863081Z","relpermalink":"/publication/dblp-confum-defiebre-sg-20/","section":"publication","summary":"","tags":[],"title":"A Decentralized Recommendation Engine in the Social Internet of Things","type":"publication"},{"authors":["Johannes Luef","Christian Ohrfandl","Dimitris Sacharidis","Hannes Werthner"],"categories":[],"content":"","date":1577836800,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1612135020,"objectID":"22ebe17e7b8557b46f19a7bb2dfbf198","permalink":"/publication/2020-sac-a/","publishdate":"2021-01-31T23:19:13.305656Z","relpermalink":"/publication/2020-sac-a/","section":"publication","summary":"Selecting the appropriate enterprise to invest in can become a difficult task for prospective investors, particularly in the case of startups where limited information is available. In this work, we design, implement, and evaluate a system that makes recommendations for investing in early-stage enterprises. We first perform a qualitative and quantitative study involving prominent investors to explore their decision-making process and set out the requirements for a recommender system. Then, we consider various recommendation approaches that best convey the results of our requirements analysis. To evaluate the different methods, we simulate an offline experiment, placing real investors in a hypothetical investment decision scenario.","tags":[],"title":"A recommender system for investing in early-stage enterprises","type":"publication"},{"authors":["Dimitris Sacharidis"],"categories":[],"content":"","date":1577836800,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1612133343,"objectID":"3b5835a02eaa3940d8d8ac4fa31d9df8","permalink":"/publication/dblp-confum-sacharidis-20/","publishdate":"2021-01-31T23:19:14.925767Z","relpermalink":"/publication/dblp-confum-sacharidis-20/","section":"publication","summary":"","tags":[],"title":"Building User Trust in Recommendations via Fairness and Explanations","type":"publication"},{"authors":["Daniel Defiebre","Panagiotis Germanakos","Dimitris Sacharidis"],"categories":[],"content":"","date":1577836800,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1612133342,"objectID":"aa5ea395b985ab6c12454ac29237065f","permalink":"/publication/dblp-confum-defiebre-gs-20/","publishdate":"2021-01-31T23:19:14.616637Z","relperm