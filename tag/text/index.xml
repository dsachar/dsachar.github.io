               /publication/2024-icde-rnr/THOR_huedb97c29eb39abb664dd39d63c88efbc_1003081_3d0ed3998fb824bae9553373752e32e5.webp 760w,
               /publication/2024-icde-rnr/THOR_huedb97c29eb39abb664dd39d63c88efbc_1003081_1200x1200_fit_q75_h2_lanczos_3.webp 1200w&#34;
