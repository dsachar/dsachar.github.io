               /publication/2023-neurips-ktg/FACTS_hub56d2d0fda32ab2f4128cdc06bdcce43_85632_42eab8ec15bf4389cfdd24de19e4da56.webp 760w,
               /publication/2023-neurips-ktg/FACTS_hub56d2d0fda32ab2f4128cdc06bdcce43_85632_1200x1200_fit_q75_h2_lanczos_3.webp 1200w&#34;
               src=&#34;https://dsachar.net/publication/2023-neurips-ktg/FACTS_hub56d2d0fda32ab2f4128cdc06bdcce43_85632_814c664b54c6353564557bf89a239549.webp&#34;
               width=&#34;760&#34;
               height=&#34;96&#34;
               loading=&#34;lazy&#34; data-zoomable /&gt;&lt;/div&gt;
  &lt;/div&gt;&lt;figcaption&gt;
      &lt;em&gt;A discovered subgroup where unfairness of recourse exists.&lt;/em&gt;
    &lt;/figcaption&gt;&lt;/figure&gt;
&lt;/p&gt;
&lt;p&gt;Our approach is integrated within the &lt;a href=&#34;https://aif360.res.ibm.com&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;IBM AIF 360 tool&lt;/a&gt;. See a demo notebook &lt;a href=&#34;https://github.com/Trusted-AI/AIF360/blob/main/examples/demo_FACTS.ipynb&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;here&lt;/a&gt;.&lt;/p&gt;
