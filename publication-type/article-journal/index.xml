               /publication/2023-is-kgs/SDEaaS_hu2999d8c75489d888439a4e556d6a696d_2324279_aa5cbcb89072234cc56e8a35caed777e.webp 760w,
               /publication/2023-is-kgs/SDEaaS_hu2999d8c75489d888439a4e556d6a696d_2324279_1200x1200_fit_q75_h2_lanczos_3.webp 1200w&#34;
               src=&#34;https://dsachar.net/publication/2023-is-kgs/SDEaaS_hu2999d8c75489d888439a4e556d6a696d_2324279_6e5bc97f8d442711873571fa50aa218b.webp&#34;
               width=&#34;760&#34;
